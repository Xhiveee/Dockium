# syntax=docker/dockerfile:1

FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/dockium-agent ./cmd/dockium-agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata docker-cli \
    && mkdir -p /data
COPY --from=build /out/dockium-agent /usr/local/bin/dockium-agent
ENV DOCKIUM_AGENT_DATA=/data
VOLUME /data
ENTRYPOINT ["dockium-agent"]
